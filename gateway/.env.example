# Copy to .env and fill in. Never commit .env.
SERVER_URL=https://your-site.example.com
GATEWAY_TOKEN=            # the same value as GATEWAY_API_TOKEN on the website
GATEWAY_ID=shop-gateway-1
# Only for a protected Vercel preview (e.g. staging): Project Settings > Deployment Protection >
# Protection Bypass for Automation.
# VERCEL_PROTECTION_BYPASS=

# simulated = no hardware (for testing). at-modem = USB GSM modems. mymtn-app = the myMTN Android app.
DRIVER=simulated
SIM_NUMBERS=08000000001,08000000002
# SIM_BEHAVIOR=success    # success | limit | bundle | fail | unknown | hang

# DRIVER=at-modem
# MODEMS=[{"sim":"08031234567","port":"/dev/ttyUSB0"},{"sim":"08039876543","port":"/dev/ttyUSB1"}]

# MTN's published gifting code. CONFIRM with one real transfer (npm run try) before going live.
# USSD_TEMPLATE=*312*{recipient}*{amount}#
# AMOUNT_FORMAT=mb

# What MTN's replies look like, as regular expressions, several joined with ||
# Leave empty until you have seen real replies: unmatched replies are reported as "unknown",
# which parks the order for an admin instead of guessing.
# SUCCESS_PATTERNS=
# LIMIT_PATTERNS=
# BUNDLE_PATTERNS=
# FAILED_PATTERNS=

# DRIVER=mymtn-app          (see "The myMTN app driver" in README.md)
# ADB_PATH=adb
# MYMTN_DRY_RUN=1           # every step and check, but stop before tapping Share
# MYMTN_PROFILES={"08031234567":10}   # optional: normally read from the phone
