# Copy to .env.local and fill in. Never commit .env.local — it's gitignored by default.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack test keys from the dashboard (Settings > API Keys & Webhooks).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
