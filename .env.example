# Copy to .env.local and fill in. Never commit .env.local — it's gitignored by default.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Monipay keys from the dashboard (Settings > API Keys). Both server-only — neither is
# ever sent to the browser; the client only ever receives the resulting checkout URL.
# The public key is required for /transaction/initialize specifically — Monipay's live
# API rejects the secret key there ("Use public key for this endpoint").
MONIPAY_PUBLIC_KEY=
# Used for /transaction/verify and to check webhook signatures.
MONIPAY_SECRET_KEY=

# VTU.ng account (airtime/data fulfillment). VTU_USERNAME is the account's email — this
# account has no separate username. VTU_USER_PIN is a transaction PIN, distinct from the
# login password, used only to verify webhook signatures.
VTU_USERNAME=
VTU_PASSWORD=
VTU_USER_PIN=

# Optional. Naira balance below which admins get a "VTU wallet low" notification via the
# periodic cron check (see vercel.json). Defaults to 5000 if unset.
VTU_LOW_BALANCE_THRESHOLD=

# Optional but recommended once deployed — secures app/api/cron/* routes so only Vercel's
# own cron scheduler can trigger them. Set the same value in Vercel's project env vars.
CRON_SECRET=

# SMEData.ng reseller API token (Reseller Dashboard > API/token). Passed as a URL query
# param on every request per their API design — treat it as sensitive as any other key
# despite that, and never log full request URLs.
SMEDATA_API_TOKEN=
